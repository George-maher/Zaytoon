# Normalise line endings so the Windows working tree and the committed blobs
# agree. Without this, git warns on every checkout and `start.sh` can arrive
# with CRLF, which bash refuses to execute.

* text=auto

*.py    text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.sh    text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.db    binary
*.exe   binary
*.woff  binary
*.woff2 binary
