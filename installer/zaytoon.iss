; autogenerated by scripts/create_iss.py — do not edit by hand.
; Regenerate with:  python scripts/create_iss.py
;
; This file is written from a RAW template on purpose: an earlier hand-written
; version contained a literal form-feed where the "\f" of "\frontend" was
; parsed as a control character, so [Files] pointed at paths that never
; existed and the installer shipped no frontend at all.

#define MyAppName "Zaytoon"
#define MyAppVersion "3.0.0"
#define MyAppPublisher "Zaytoon AI"
#define MyAppURL "https://github.com/George-maher/Zaytoon"
#define MyAppExeName "Zaytoon.exe"
; Absolute, resolved by create_iss.py: the onedir bundle from build_exe.py.
#define BundleDir "D:\my work\Zaytoon\desktop\dist\Zaytoon"

[Setup]
AppId={{8F4E2A91-6C3D-4B7E-9A15-2D6C0B8E5F10}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}/issues
VersionInfoVersion=3.0.0
VersionInfoDescription=Zaytoon AI desktop assistant installer
; {autopf} resolves to {pf} for an all-users install and
; {localappdata}\Programs for a per-user one, and the dialog below lets the
; user pick which — one artifact serving both, no separate builds.
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
PrivilegesRequired=admin
PrivilegesRequiredOverridesAllowed=dialog commandline
; Upgrades: same AppId above, so a new setup replaces the previous install in
; place and keeps its recorded location; a running instance is asked to close
; instead of failing on a locked .exe.
UsePreviousAppDir=yes
CloseApplications=yes
RestartApplications=no
OutputDir=D:\my work\Zaytoon\installer\dist
OutputBaseFilename=Zaytoon-Setup-3.0.0
SetupIconFile=D:\my work\Zaytoon\desktop\icons\zaytoon.ico
UninstallDisplayIcon={app}\{#MyAppExeName}
UninstallDisplayName={#MyAppName}
Compression=lzma2/max
SolidCompression=yes
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.17763
WizardStyle=modern
ShowLanguageDialog=auto
AllowNoIcons=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "Create a &desktop shortcut"; GroupDescription: "Additional shortcuts:"
Name: "startup"; Description: "Start {#MyAppName} when I sign in"; GroupDescription: "Startup:"; Flags: unchecked

[Files]
; The whole onedir bundle: the shell executable plus _internal/ (the frozen
; Python runtime, the backend source tree and the production frontend).
Source: "D:\my work\Zaytoon\desktop\dist\Zaytoon\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Registry]
; Per-user Run entry rather than the Startup folder: it lands in the right
; hive for whichever install mode was chosen, and uninstall removes exactly
; what it created.
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; \
    ValueType: string; ValueName: "{#MyAppName}"; ValueData: """{app}\{#MyAppExeName}"""; \
    Flags: uninsdeletevalue; Tasks: startup

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "Launch {#MyAppName}"; \
    Flags: nowait postinstall skipifsilent

[UninstallRun]
; Stop a running instance before uninstall so its files are not locked.
Filename: "taskkill.exe"; Parameters: "/IM {#MyAppExeName} /T"; \
    Flags: runhidden; RunOnceId: "StopZaytoon"

[UninstallDelete]
; ONLY the application's own files under {app}. The user's data lives in
; %LOCALAPPDATA%\Zaytoon (database, reminders, settings, logs) and is never
; touched here — see [Code]::CurUninstallStepChanged for the explicit opt-in.
Type: filesandordirs; Name: "{app}"

[Code]
function WebView2RuntimeInstalled(): Boolean;
var
  Found: String;
begin
  { Evergreen runtime: the EdgeUpdate client key carries the installed
    version under 'pv'. A 'pv' of 0.0.0.0 is what the uninstaller leaves
    behind, so it must not count as installed. }
  if RegQueryStringValue(HKLM,
      'SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}',
      'pv', Found) then
  begin
    Result := (Found <> '') and (Found <> '0.0.0.0');
    if Result then Exit;
  end;
  if RegQueryStringValue(HKCU,
      'Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}',
      'pv', Found) then
  begin
    Result := (Found <> '') and (Found <> '0.0.0.0');
    if Result then Exit;
  end;
  { Fixed-path fallback, same rule as desktop/app/host.py. }
  Result := DirExists(ExpandConstant('{commonpf64}\Microsoft\EdgeWebView\Application'))
    or DirExists(ExpandConstant('{commonpf32}\Microsoft\EdgeWebView\Application'));
end;

function InitializeSetup(): Boolean;
var
  ErrorCode: Integer;
begin
  Result := True;
  if not WebView2RuntimeInstalled() then
  begin
    if MsgBox('The Microsoft Edge WebView2 runtime is not installed, and Zaytoon''s'
      + ' window needs it. Download and install it now? (Otherwise Zaytoon will'
      + ' start but show a blank window.)',
      mbConfirmation, MB_YESNO) = IDYES then
    begin
      ShellExec('open',
        'https://developer.microsoft.com/microsoft-edge/webview2/', '', '',
        SW_SHOW, ewNoWait, ErrorCode);
    end;
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  DataDir: String;
begin
  { User data is preserved by default. The flag file is written only when
    someone explicitly chose "delete my data", so a plain uninstall keeps the
    database, reminders and settings exactly where they are. }
  if CurUninstallStep = usPostUninstall then
  begin
    DataDir := ExpandConstant('{localappdata}\Zaytoon');
    if FileExists(ExpandConstant('{app}\delete-user-data.flag')) then
    begin
      if DirExists(DataDir) then
        DelTree(DataDir, True, True, True);
    end;
  end;
end;
