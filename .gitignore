# Python
__pycache__/
*.py[cod]
*.db
# SQLite sidecar files: without these the journal mode looks absent
# and a stale WAL is committed on every run.
*.db-wal
*.db-shm
*.sqlite3
.env
venv/
.venv/
*.egg-info/
dist/
build/

# Node
node_modules/
dist/
.vite/

# Rust
# The desktop shell is Python/pywebview, not Tauri, so there is no
# src-tauri/target. `target/` is kept for anyone experimenting with a Rust
# sidecar without polluting the root.
target/

# The checkout's portable home (install.sh creates the same layout at
# $ZAYTOON_HOME): the desktop host persists window state to Config/ when
# ZAYTOON_HOME is unset.
/Config/

# PyInstaller output from desktop/scripts/build_exe.py
desktop/dist/
desktop/build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Data
data/*.db
data/chroma/
