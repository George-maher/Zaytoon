# Zaytoon AI v3.0 - Backend Configuration

# ---------------------------------------------------------------------------
# LLM provider — Ollama (default, local) or OpenRouter (cloud, optional)
#
# AI_PROVIDER selects the backend:
#   AI_PROVIDER=ollama       local inference through Ollama — no API key
#   AI_PROVIDER=openrouter   cloud inference through OpenRouter — needs a key
#
# OLLAMA (default) — nothing is downloaded or run unless you install it
# yourself with `ollama pull`. If a configured model is missing, Zaytoon
# reports "MODEL NOT INSTALLED" with the exact pull command; it never pulls a
# model on its own.
# ---------------------------------------------------------------------------

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# Three local models, one per capability tier (edit to any tags you have):
#   general  — chat and everyday requests
#   coding   — code, planning, scheduling (reasoning tier)
#   fast     — tool selection and intent routing (fast tier)
OLLAMA_GENERAL_MODEL=qwen3.5:9b
OLLAMA_CODING_MODEL=qwen2.5-coder:7b
OLLAMA_FAST_MODEL=qwen2.5-coder:3b

# ---------------------------------------------------------------------------
# OpenRouter (only used when AI_PROVIDER=openrouter)
#
# ZERO-COST POLICY (two layers, both enforced before any socket is opened):
#   1. The model must carry the ":free" suffix. Anything else is treated as
#      billable and refused, including "vendor/free-tier-model".
#   2. The model must also be in the curated allow-list in
#      backend/services/model_registry.py, which also records each model's
#      capabilities (tools / structured output / streaming).
#
# `openrouter/free` is NOT usable and is deliberately not on the list. It is
# free, but it is an *uncontrolled* auto-router: it can resolve to a different
# arbitrary free model on every call, which makes a routing bug impossible to
# reproduce and a fix impossible to verify. It also answered a `get_time`
# request with the literal string "User Safety: safe", which the agent loop
# accepted as the assistant's answer. Configure explicit models instead.
#
# With AI_PROVIDER=openrouter there is no local fallback: if OpenRouter is
# unreachable the assistant degrades loudly rather than silently switching
# providers.
# ---------------------------------------------------------------------------

# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Endpoint. The client posts to <base>/chat/completions.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Chain order. Every model below must be allow-listed AND carry ":free".
#
# Primary  : chat, tool selection, intent routing
# Reasoning: code, planning, scheduling
#
# OPENROUTER_FREE_FALLBACK_MODELS is the explicit fallback pool, tried in the
# order written. Fallback happens on BOTH transport failure (429 / 5xx /
# timeout) AND contract failure (unknown tool, bad arguments, missing tool
# call, empty completion, provider metadata leaked as content).
#
# To add a model: put it in MODEL_REGISTRY (services/model_registry.py) with
# its verified capabilities, then list it here. Adding a *paid* model is
# impossible — the ":free" guard rejects it before any socket is opened.
OPENROUTER_PRIMARY_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_REASONING_MODEL=cohere/north-mini-code:free
OPENROUTER_FREE_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-lightning:free,cohere/north-mini-code:free,poolside/laguna-s-2.1:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Hard ceiling on model calls for one request, across every model in the chain.
# This is what makes an infinite fallback loop impossible.
OPENROUTER_MAX_ATTEMPTS=3

# A 429 benches a model for at least this long, so a contended model is skipped
# rather than retried. Rate limits are per-model, not per-endpoint, so moving to
# a different free model is nearly always better than waiting.
LLM_PROVIDER_COOLDOWN=60
LLM_RATE_LIMIT_COOLDOWN=90

# Second line of defence. Keep true unless you deliberately accept billable
# traffic; the allow-list check is not disabled by this flag.
LLM_REQUIRE_FREE_MODELS=true

# Attribution headers (https://openrouter.ai/docs/api-reference/overview)
OPENROUTER_SITE_URL=https://github.com/zaytoon-ai
OPENROUTER_APP_TITLE=Zaytoon AI Assistant

# LLM transport tuning
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
# Seconds a model is benched after a 429/5xx instead of being retried
LLM_PROVIDER_COOLDOWN=60
LLM_MAX_TOKENS_CAP=8192

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database
DATABASE_URL=sqlite:///./data/zaytoon.db

# ---------------------------------------------------------------------------
# Workspace — the directory every file tool is confined to
# ---------------------------------------------------------------------------
# This is NOT the process working directory. The backend must be launched from
# `backend/`, so a cwd-based root confined the assistant to its own source tree
# and made project creation, repository inspection and git operations
# impossible. Containment uses os.path.commonpath, so a sibling directory that
# merely shares a name prefix (…/ws vs …/ws_evil) is still rejected.
#
# It can also be changed at runtime, without a restart:
#     GET  /settings/workspace
#     POST /settings/workspace  {"root": "D:/Projects"}
# which persists the choice as a preference.
WORKSPACE_ROOT=~/ZaytoonWorkspace
WORKSPACE_ENFORCED=true

# Whisper STT (tiny = CPU-optimized, int8 quantized)
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Edge TTS Voices — the voice is chosen per message from the detected language
# (see voice/routing.py). These are the overrides for the "ar" and "en"
# profiles; leave them unset to use the registry defaults.
# Arabic (Egyptian): ar-EG-ShakirNeural -> ar-EG-SalmaNeural
# English:            en-GB-RyanNeural  -> en-US-GuyNeural
TTS_VOICE_AR=ar-EG-ShakirNeural
TTS_VOICE_EN=en-GB-RyanNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_STREAM_EARLY=true

# Wake-word follow-up window (seconds without repeating "Zaytoon")
WAKE_SESSION_TIMEOUT=10

# Require the wake word at the start of every voice utterance. Anything else is
# discarded. Set to false if you would rather every transcript be answered
# (handy for desk testing, or once the mic is an explicit click rather than an
# automatic prompt on page load).
WAKE_WORD_REQUIRED=true

# Tell the client when an utterance was dropped for missing the wake word,
# instead of silently answering "listening".
WAKE_WORD_HINT=true

# ---------------------------------------------------------------------------
# Tool safety sandbox (human-in-the-loop)
# ---------------------------------------------------------------------------
# When true, high-risk tool calls pause and wait for the user to approve via a
# `require_confirmation` WebSocket event.
TOOL_SAFETY_ENABLED=true
# Seconds to wait for approval before the action is denied.
TOOL_CONFIRM_TIMEOUT=120
# Extra actions to always require approval, on top of the built-in permission
# tiers. You rarely need to change this: `system_command` (any command),
# `file_write`, `create_folder`, `run_npm`, `type_text`, `key_press` and every
# state-modifying `git_*` verb are already confirmation-required by tier.
# See the tier table in AGENTS.md.
TOOL_ALWAYS_CONFIRM=run_code,file_delete,registry_write

# Rate Limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60
